import {
  CheckpointTrust,
  ReleaseQualification,
  SignedCheckpoint,
  Source,
  qualify_release_files,
  require_controller_artifact,
} from "smart-ship/lib"

type Configuration = {trust: CheckpointTrust, controller: string}

type Input = {checkpoint_file: string, checkpoint: string, source: Source, artifact: string}

/** Read only the deployment's pinned trust; downloaded receipts cannot select their issuer. */
pub fn guard_release(
  harness: Harness,
  configuration: Configuration,
  input: Input,
) -> ReleaseQualification {
  require_controller_artifact(pick(harness, ["env", "fs", "process"]), configuration.controller)
  const text = harness.fs.read_text(input.checkpoint_file)
  require len(text) <= 16777216, "checkpoint exceeds its size limit"
  const signed: SignedCheckpoint = schema_expect(json_parse(text), schema_of(SignedCheckpoint))
  const artifact = {
    name: "pages",
    digest: "sha256:" + sha256_hex(harness.fs.read_bytes(input.artifact)),
  }
  return unwrap(
    qualify_release_files(
      harness.fs,
      signed,
      configuration.trust,
      {checkpoint: input.checkpoint, source: input.source, artifacts: [artifact]},
      [{name: artifact.name, path: input.artifact}],
    ),
  )
}

fn main(harness: Harness) {
  require len(argv) == 1, "pass one public release request file"
  const configuration: Configuration = schema_expect(
    json_parse(harness.fs.read_text(path_join(harness.fs.source_dir(), "configuration.json"))),
    schema_of(Configuration),
  )
  const input: Input = schema_expect(json_parse(harness.fs.read_text(argv[0])), schema_of(Input))
  harness.stdio.println(json_stringify(guard_release(harness, configuration, input)))
}
